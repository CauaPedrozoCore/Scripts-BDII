Create Procedure spItensEnc 
	@idEnc Int,
	@idProd Int,
	@qtdKilos Float,
	@subTotal Money
As
Begin 
	Insert tbItensEncomenda(idEncomenda, idProduto, qtdKilos, subTotal)
			Values (@idEnc, @idProd, @qtdKilos, @subTotal)
End

