Create Procedure spInserirItensEncomenda
	@idEnc Int,
	@idProd Int,
	@qtdKilos Float,
	@subTotal Money
As
Begin
	If Exists (Select idEncomenda From tbEncomenda Where idEncomenda = @idEnc)
End
	Begin
		If Exists (Select idProduto From tbProduto Where idProduto = @idProd)
  End
		Begin
			Insert Into tbItensEncomenda(idEncomenda, idProduto, qtdKilos, subTotal)
			Values (@idEnc, @idProd, @qtdKilos, @subTotal)
    End

Exec spInserirItensEncomenda 1, 1, 2.5, 105.00
Select * From tbItensEncomenda
